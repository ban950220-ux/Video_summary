{
  "name": "영상요약",
  "short_name": "영상요약",
  "description": "YouTube 영상을 자막·전사 기반으로 요약하는 개인용 앱",
  "lang": "ko",
  "id": "/v1/",
  "start_url": "/v1/",
  "scope": "/v1/",
  "display": "standalone",
  "background_color": "#101d2b",
  "theme_color": "#101d2b",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/v1/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
